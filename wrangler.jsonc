{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instabox-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "vars": {
    "INSTABOX_API_URL": "https://api.instabox.sh",
    "MAX_WAIT_SECONDS": "45"
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV" }
  ]
}
