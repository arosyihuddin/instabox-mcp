{
  "name": "instabox-mcp",
  "version": "0.5.0",
  "description": "Remote MCP server for InstaBox cloud machines, with built-in single-user OAuth",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node_modules/.bin/wrangler dev",
    "deploy": "node_modules/.bin/wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun run build && bun test",
    "cf:types": "node_modules/.bin/wrangler types --include-runtime false",
    "build": "tsc -p tsconfig.build.json"
  },
  "license": "MIT",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  }
}
